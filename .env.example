# Local Supabase
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=

# Enable response-delivered OTP for a private, single-worker localhost backend.
CIMFEST_LOCAL_OTP_ENABLED=false

# A stable, random secret of at least 32 bytes for guest and invitation tokens
CIMFEST_TOKEN_SECRET=
CIMFEST_PUBLIC_URL=https://kamerpay.cm
CIMFEST_PREVIEW_BASE_URL=
CIMFEST_INVITATION_TTL_HOURS=168

# Optional comma-separated, verified three-digit subscriber prefixes
CIMFEST_MTN_PREFIXES=
CIMFEST_ORANGE_PREFIXES=
